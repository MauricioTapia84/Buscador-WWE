FROM python:3.11-slim
WORKDIR /app

RUN printf '%s\n' \
	'deb https://deb.debian.org/debian trixie main contrib non-free' \
	'deb https://deb.debian.org/debian-security trixie-security main contrib non-free' \
	'deb https://deb.debian.org/debian trixie-updates main contrib non-free' \
	> /etc/apt/sources.list.d/debian.list \
	&& apt-get update \
	 && apt-get install -y --no-install-recommends \
		 apt-transport-https \
		 build-essential \
		 gcc \
		 libpq-dev \
		 curl \
		 ca-certificates \
	 && rm -rf /var/lib/apt/lists/*

COPY etl/requirements.txt /app/requirements_etl.txt
COPY api/requirements.txt /app/requirements_api.txt
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r /app/requirements_etl.txt && \
    pip install --no-cache-dir -r /app/requirements_api.txt && \
    pip install --no-cache-dir pytest pytest-cov

COPY etl /app/etl
COPY api /app/api
COPY tests /app/tests
COPY etl/run_etl.py /app/run_etl.py
RUN ln -s /app /app/wrestling-pipeline || true

ENV PYTHONPATH=/app
CMD ["pytest", "-v", "/app/tests"]
